  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@ai-sdk/cohere": "^4.0.34",
    "@ai-sdk/deepseek": "^3.0.36",
    "@ai-sdk/google": "^4.0.57",
    "@ai-sdk/groq": "^4.0.34",
    "@ai-sdk/mistral": "^4.0.36",
    "@ai-sdk/openai": "^4.0.51",
    "@ai-sdk/xai": "^4.0.49",
    "ai": "^7.0.84",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ws": "^8.21.3",
    "zod": "^4.5.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
